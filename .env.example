# ==============================================================================
# Adhikaar Platform — Environment Variables Example
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# --- Backend API Configuration (apps/api) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/adhikaar?retryWrites=true&w=majority
# Note: If left empty, API runs in standalone mode with DB status "not_configured"
MONGODB_URI=

# --- Frontend Configuration (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:5000
